# mcbench working state — provisioned game files and mod jars must never be
# committed (see docs/LICENSING.md: no redistribution of Minecraft or mods).
/work/
/instances/
/cache/
/results/
*.jar
# The Gradle wrapper jar is our own build tooling, not a redistributed mod, and
# committing it is what lets adopters build the probe without installing Gradle.
!probe/gradle/wrapper/gradle-wrapper.jar

# Java / Gradle (probe mod, milestone 2)
.gradle/
bin/
out/

