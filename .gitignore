# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# mcbench working state. Provisioned game files and mod jars must never be
# committed (see docs/LICENSING.md: no redistribution of Minecraft or mods).
/work/
/work-*/
/instances/
/cache/
/results/
*-results.json
# Derived from results-*.json by `mcbench analyse`, in seconds, and
# stale the moment the analysis changes. The raw runs are committed;
# these are not.
/report/
/report-*/
/work/sensitivity-report/
# HeadlessMC keeps its own state, including the logged-in session, beside
# whatever directory it was run from.
/HeadlessMC/
*.jar
# Gradle wrapper jars are our own build tooling, not redistributed mods, and
# committing them is what lets adopters build the probe without installing
# Gradle. Adapters carry their own wrapper because their loaders pin different
# Gradle versions (see docs/PLATFORMS.md).
!gradle/wrapper/gradle-wrapper.jar
!**/gradle/wrapper/gradle-wrapper.jar

# Java / Gradle (probe mod, milestone 2)
.gradle/
bin/
out/

# Editors / OS
.idea/
.vscode/
.DS_Store
